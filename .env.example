# ==========================================================
# EduBot AI – Future Learning Ecosystem Environment Config
# Copy this file to .env for local development.
# NEVER commit real secrets, API keys, or private keys to Git.
# ==========================================================

# 1. Server-side Gemini AI Key (Required for AI Tutor, AI Teacher & Embeddings)
# Obtain from Google AI Studio / Google Cloud Console
GEMINI_API_KEY="YOUR_GEMINI_API_KEY"

# 2. Session Signing Secret (Required in production for HMAC bearer sessions)
SESSION_SECRET="REPLACE_WITH_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS"

# 3. Runtime Environment & Hosting
NODE_ENV="development"
PORT=3000
APP_URL="http://localhost:3000"
ALLOWED_ORIGIN="http://localhost:3000,https://edubot-u4d6.vercel.app"

# 4. Firebase Client Web Configuration (Optional override for firebase-applet-config.json)
# Only public Firebase Web SDK config should use VITE_ prefix.
# NEVER place Firebase Admin private keys in VITE_ variables.
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_PROJECT_ID="gen-lang-client-0856385601"
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_FIRESTORE_DATABASE_ID="ai-studio-edubotaifuturele-d205c94b-e2cf-4652-87cf-2a79b157a8e5"
VITE_ENABLE_DEMO_LOGIN="false"

# 5. Firebase Server-side Project & Database Verification
FIREBASE_PROJECT_ID="gen-lang-client-0856385601"
FIRESTORE_DATABASE_ID="ai-studio-edubotaifuturele-d205c94b-e2cf-4652-87cf-2a79b157a8e5"

# 6. Initial Admin Bootstrap Email (Never self-assignable by other users)
BOOTSTRAP_ADMIN_EMAIL="vulin1000@gmail.com"

# 7. Demo Account Passwords (Used ONLY for non-production local testing, never production)
ENABLE_DEMO_SEED="false"
DEMO_ADMIN_PASSWORD=""
DEMO_TEACHER_PASSWORD=""
DEMO_STUDENT_PASSWORD=""
